# 이 파일을 .env 로 복사하고 값을 바꾼다. .env 는 커밋하지 않는다.

# 웹 서버 주소 (로컬 개발: http://localhost:8787)
GLOTFAX_SERVER=http://localhost:8787

# 게이트웨이 등록 때 받은 토큰 (gfg_...)
GLOTFAX_TOKEN=

# 팩스 백엔드: mock(가짜 전송) | epson | hp
GLOTFAX_BACKEND=mock

# 작업 파일·기록 위치
GLOTFAX_DATA_DIR=./data

# mock: 전송에 걸리는 시간(ms). 번호가 000 으로 시작하면 실패로 처리
MOCK_DELAY_MS=3000
# sent: 완료로 처리(로컬 화면 테스트) | failed: 모두 실패로 처리(운영에서 실제 백엔드 준비 전)
MOCK_RESULT=sent

# epson: CUPS 에 등록한 PC-Fax 2 프린터 이름, 드라이버 로그 위치
EPSON_PRINTER=EPSON_FAX2
EPSON_LOG=/tmp/epsonfax2-log.txt

# hp: HPLIP 팩스 대기열 이름, hp-sendfax 를 실행할 일반 사용자 (root 불가, lp·lpadmin 그룹)
HP_PRINTER=HP_FAX
HP_USER=glotfax

# 에이전트는 Windows, 드라이버는 WSL 안에 있을 때 배포판 이름 (예: Ubuntu-24.04). 리눅스에서 돌면 비워 둔다
FAX_WSL_DISTRO=
